# Postgres.app (current local setup):
DATABASE_URL=postgres://emilyteng@localhost:5432/career_digest
# Docker Compose alternative:
# DATABASE_URL=postgres://career_digest:career_digest@localhost:5432/career_digest
PORT=3000
OPENAI_API_KEY=
# Optional. Default: gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
# Optional cap for a trial run: RANK_LIMIT=25
# npm run rank uses the Batch API (separate quota, 50% cheaper).
# npm run rank:live uses synchronous calls with a client-side throttle.
# If Batch progress stalls (no completed/failed advance) for this many hours,
# cancel, apply partial results, and live-retry a small leftover set.
# BATCH_STALL_HOURS=12
# When unfinished jobs after a batch are ≤ this count, finish them with live
# ranking (same as rank:live / board light-rank) instead of another Batch file.
# BATCH_LIVE_FALLBACK_MAX=50
# Defaults below are gpt-4o-mini Tier 1. Headers and 429s still update at runtime.
# OPENAI_RPM=500
# OPENAI_RPD=10000
# OPENAI_TPM=200000
# RANK_CONCURRENCY=1
# Light live ranking after each board refresh (API button + 5pm cron).
# Skipped while a Batch job is still in progress. Default: 40.
# BOARD_RANK_LIMIT=40

