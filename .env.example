# App runtime (ingest, API, rank) — copy to .env and fill in secrets.
DATABASE_URL=postgres://YOUR_USER@localhost:5432/career_digest

# Integration tests only — must be a separate *_test database (never career_digest).
TEST_DATABASE_URL=postgres://YOUR_USER@localhost:5432/career_digest_test

# Docker Compose alternative for DATABASE_URL:
# DATABASE_URL=postgres://career_digest:career_digest@localhost:5432/career_digest
# TEST_DATABASE_URL=postgres://career_digest:career_digest@localhost:5432/career_digest_test

PORT=3000
OPENAI_API_KEY=

# Home greeting (optional). When unset, the UI shows only "Good morning" etc.
# DIGEST_GREETING_NAME=Alex

# Rank system prompt — copy config/rank-profile.example.md to config/rank-profile.md
# (or set an absolute path). Required for npm run rank / board light-rank.
# RANK_PROFILE_PATH=config/rank-profile.md

# Optional — unset values use code defaults (see comments below).
# OPENAI_MODEL=gpt-4o-mini
# RANK_LIMIT=25
# BATCH_STALL_HOURS=12          # default 12
# BATCH_LIVE_FALLBACK_MAX=50    # default 50
# BOARD_RANK_LIMIT=40           # default 40
# OPENAI_RPM=500
# OPENAI_RPD=10000
# OPENAI_TPM=200000
# RANK_CONCURRENCY=1
