{
  "name": "career-digest",
  "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev:api": "npm run dev -w @career-digest/api",
    "dev:web": "npm run dev -w @career-digest/web",
    "ingest": "npm run ingest -w @career-digest/api",
    "scrape": "npm run scrape -w @career-digest/api",
    "rank": "npm run rank -w @career-digest/api",
    "rank:live": "npm run rank:live -w @career-digest/api",
    "rank:live-backlog": "npm run rank:live-backlog -w @career-digest/api",
    "board-refresh": "npm run board-refresh -w @career-digest/api",
    "cron:install": "bash scripts/install-daily-board.sh",
    "cron:uninstall": "bash scripts/uninstall-daily-board.sh",
    "migrate": "npm run migrate -w @career-digest/api",
    "discover-boards": "npm run discover-boards -w @career-digest/api --",
    "merge-postings": "npm run merge-postings -w @career-digest/api",
    "backup": "bash scripts/backup-db.sh",
    "restore": "bash scripts/restore-db.sh",
    "cron:install-backup": "bash scripts/install-daily-backup.sh",
    "test": "npm run test -w @career-digest/api",
    "test:watch": "npm run test:watch -w @career-digest/api"
  }
}
